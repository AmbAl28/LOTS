{
  "emulators": {
    "hosting": {
      "port": 5100
    }
  },
  "hosting": {
    "site": "crooked-mirror",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "README.md",
      "package*.json",
      "test-pw/**",
      "test-media/**",
      "ДЕПЛОЙ-FIREBASE.md"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
